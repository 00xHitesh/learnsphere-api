APP_ENV=development
APP_PORT=8080

# Postgres — use DATABASE_URL or individual fields
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=learnsphere

# JWT — replace with strong random secrets in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXP_MIN=15
JWT_REFRESH_EXP_DAY=7
